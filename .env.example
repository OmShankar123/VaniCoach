# Vani.Coach Mobile Environment Configuration Template
# Copy this file to .env or .env.local

# Application Environment (development | staging | production)
EXPO_PUBLIC_APP_ENV=development

# Vani.Coach Coaching & Evaluation API
EXPO_PUBLIC_API_URL=https://api.vani.coach/v1
EXPO_PUBLIC_COACHING_SERVICE_URL=https://experience.vani.coach

# AI Evaluation Service Configuration
EXPO_PUBLIC_AI_EVALUATION_MODEL=vani-coaching-eval-v2
EXPO_PUBLIC_MOCK_AI_DELAY_MS=2200

# Feature Flags
EXPO_PUBLIC_ENABLE_VOICE_RECORDING=true
EXPO_PUBLIC_ENABLE_DEBUG_STATS=true